# Key names topic-research understands. Real values do NOT go in this directory:
# put them in ~/.config/secrets/keys.env (chmod 600). research.py reads the environment first, then that file.
# All keys are optional; without them research.py uses keyless paths (see `research.py doctor`).

PARALLEL_API_KEY=        # https://platform.parallel.ai  web search + page extract (set a monthly cap)
EXA_API_KEY=             # https://dashboard.exa.ai      papers / GitHub / docs search ($10/mo free)
OPENALEX_API_KEY=        # https://openalex.org          paper recall (free key, $1/day budget)
ALPHAXIV_API_KEY=        # https://www.alphaxiv.org → Settings → API Keys  paper search + page-cited PDF reading (free account quota)
S2_API_KEY=              # optional: https://www.semanticscholar.org/product/api  influential citations (keyless is skipped)
GITHUB_TOKEN=            # fine-grained, public repos read-only; on a Mac `gh auth token` is used if unset
DEEPSEEK_API_KEY=        # optional: Chinese sources, cheapest backstop (omp also uses this name for its DeepSeek models)
JINA_API_KEY=            # optional: Jina search; the reader works keyless
